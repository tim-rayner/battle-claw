# Required: Your PUBG API key from https://developer.pubg.com
PUBG_API_KEY=your_api_key_here

# Optional: Default platform shard (steam, kakao, psn, xbox)
PUBG_PLATFORM=steam

# Optional: Cache directory
PUBG_CACHE_DIR=~/.pubg-stats/cache

# Optional: Rate limit (requests per minute)
PUBG_RATE_LIMIT=10
