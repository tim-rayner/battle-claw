    "node-cache": "^5.1.2"
  },
  "devDependencies": {
"@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
"@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
