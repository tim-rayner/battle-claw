{
  "name": "battle-claw",
  "version": "1.0.0",
  "description": "PUBG Stats CLI - Fetch and analyze PUBG game statistics for post-mortem insights",
  "main": "dist/index.js",
  "bin": {
    "pubg-stats": "./dist/bin/pubg-stats.js"
  },
  "scripts": {
